{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Door Frost Assistant",
  "version": "0.1.0",
  "identifier": "com.ncase.door.frost-assistant",
  "build": {
    "beforeDevCommand": "python3 -m http.server 4173",
    "devUrl": "http://localhost:4173/assistant.html",
    "frontendDist": ".."
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Door Frost Assistant",
        "url": "assistant.html",
        "width": 1120,
        "height": 520,
        "minWidth": 540,
        "minHeight": 92,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:4173; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
